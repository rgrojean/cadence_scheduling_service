{
  "name": "scheduling-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cadence — Riverbend Health appointment scheduling service",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "reminders": "tsx src/reminders/worker.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
